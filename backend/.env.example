# Server
PORT=5001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shms_db
DB_USER=shms_user
DB_PASSWORD=shms_password
DB_SSL=false

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Smart Hospital <noreply@smarthospital.com>

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=3600000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_WRITE_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=30

# Login Security & Account Lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Cron Reminders
ENABLE_CRON=true

# AI Health Assistant Configuration
AI_PROVIDER_KEY=
# Verify current model name in Anthropic documentation (e.g. claude-3-5-sonnet-20241022 or claude-3-haiku-20240307)
AI_MODEL=claude-3-5-sonnet-20241022
AI_DAILY_LIMIT_PER_USER=20
AI_MAX_INPUT_CHARS=1000
AI_TIMEOUT_MS=20000
